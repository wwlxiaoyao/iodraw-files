        <mxCell id="N0bWfw8bpWiSEuFC9uZB-9" value="PyPTO编程框架" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="5eRNpVH-V7YMr0wqcR8z-90" edge="1">
