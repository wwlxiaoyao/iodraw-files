        <mxCell id="l1_note" value="来源: fia_block_cube_nonquant_gqa.h:291-293, 680-688&lt;br&gt;L1 共 512 KB, 分 3 个 buffer pool, 每个 pool 多 buffer 用于 MTE3 预取流水" style="text;html=1;align=left;fontSize=10;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="40" y="340" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l1_q" value="&lt;b&gt;L1_Q buffer pool&lt;/b&gt;&lt;br&gt;Q_L1Tensor[2][256×192]&lt;br&gt;每 buffer 96 KB, 共 192 KB&lt;br&gt;&lt;b&gt;BF16&lt;/b&gt; (Q_T = half)&lt;br&gt;双 buffer 流水线" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="240" y="380" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l1_v" value="&lt;b&gt;L1_V buffer pool&lt;/b&gt;&lt;br&gt;V_L1Tensor[2][256×128]&lt;br&gt;每 buffer 64 KB, 共 128 KB&lt;br&gt;&lt;b&gt;INT8&lt;/b&gt; (KV_T = int8_t)&lt;br&gt;双 buffer 流水线" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="480" y="380" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l1_kp" value="&lt;b&gt;L1_KP buffer pool (K + PSE 共享)&lt;/b&gt;&lt;br&gt;KP_L1Tensor[3][128×256]&lt;br&gt;每 buffer 64 KB, 共 192 KB&lt;br&gt;&lt;b&gt;INT8&lt;/b&gt; (KV_T = int8_t)&lt;br&gt;三 buffer, K/PSE 交替复用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="720" y="380" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l1_sum" value="Σ L1 buffer pool = 192 + 128 + 192 = &lt;b&gt;512 KB&lt;/b&gt;&lt;br&gt;正好打满 512 KB L1" style="text;html=1;align=left;fontSize=11;fontStyle=5;fontColor=#CC0000;" parent="1" vertex="1">
          <mxGeometry x="1000" y="380" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ub_note" value="UB 256 KB, 分多个 LocalTensor, 用于 Vector 计算 + Cube 输出缓冲" style="text;html=1;align=left;fontSize=10;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="40" y="660" width="500" height="20" as="geometry" />
        </mxCell>
        <mxCell id="ub_q" value="qUbTensor&lt;br&gt;&lt;b&gt;BF16&lt;/b&gt; [S1_tile, D]&lt;br&gt;当前处理的 Q tile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="240" y="690" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ub_mm1" value="mm1ResUb (bmm1 结果)&lt;br&gt;&lt;b&gt;INT32&lt;/b&gt; [S1_tile, S2_tile]&lt;br&gt;Cube L0C → UB&lt;br&gt;(ANTIQUANT 模式下 mm_out = int32)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="440" y="690" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ub_softmax" value="softmaxTmpUb&lt;br&gt;softmax 中间状态&lt;br&gt;&lt;b&gt;FP32&lt;/b&gt; max/sum/exp&lt;br&gt;FlashAttention 跨 S2 迭代状态" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="680" y="690" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ub_mm2" value="mm2ResUb (bmm2 结果)&lt;br&gt;&lt;b&gt;INT32&lt;/b&gt; [S1_tile, D]&lt;br&gt;反量化前结果" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="920" y="690" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ub_accum" value="accumOutUb&lt;br&gt;&lt;b&gt;FP32&lt;/b&gt; [S1_tile, D]&lt;br&gt;累加器 (FlashAttention 状态)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="1120" y="690" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ub_out" value="outUb (最终输出)&lt;br&gt;&lt;b&gt;BF16&lt;/b&gt; [S1_tile, D]&lt;br&gt;int32 → bf16 转换后" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="1340" y="690" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l0a_desc" value="Cube 引擎 operand A 输入, 64 KB&lt;br&gt;L1→L0A 带宽: 512 bytes/cycle&lt;br&gt;数据格式: &lt;b&gt;Fractal NZ (Zn &amp; C0 交织)&lt;/b&gt;" style="text;html=1;align=left;fontSize=10;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="40" y="980" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="l0a_q" value="&lt;b&gt;L0A: Q tile (operand A for bmm1)&lt;/b&gt;&lt;br&gt;&lt;b&gt;BF16&lt;/b&gt; fractal&lt;br&gt;来自 L1_Q&lt;br&gt;IMG2COL 格式转换&lt;br&gt;shape: [M0, K0] = [S1_tile, D]&lt;br&gt;M0 = 256, K0 = 128 (典型)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="280" y="970" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l0a_attn" value="&lt;b&gt;L0A: attn tile (operand A for bmm2)&lt;/b&gt;&lt;br&gt;&lt;b&gt;INT8&lt;/b&gt; fractal&lt;br&gt;softmax 输出重新量化&lt;br&gt;来自 UB (mm1ResUb 经 softmax + quant)&lt;br&gt;shape: [M0, K0] = [S1_tile, S2_tile]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="720" y="980" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l0b_desc" value="Cube 引擎 operand B 输入, 64 KB&lt;br&gt;L1→L0B 带宽: 256 bytes/cycle&lt;br&gt;数据格式: &lt;b&gt;Fractal NZ&lt;/b&gt;" style="text;html=1;align=left;fontSize=10;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="40" y="1180" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="l0b_k" value="&lt;b&gt;L0B: K^T tile (operand B for bmm1)&lt;/b&gt;&lt;br&gt;&lt;b&gt;INT8&lt;/b&gt; fractal&lt;br&gt;来自 L1_KP (经 MTE2 或直接 DMA)&lt;br&gt;LOAD2D 格式转换&lt;br&gt;shape: [K0, N0] = [D, S2_tile] (转置后)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="440" y="1180" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l0b_v" value="&lt;b&gt;L0B: V tile (operand B for bmm2)&lt;/b&gt;&lt;br&gt;&lt;b&gt;INT8&lt;/b&gt; fractal&lt;br&gt;来自 L1_V (经 MTE2 或直接 DMA)&lt;br&gt;LOAD2D 格式转换&lt;br&gt;shape: [K0, N0] = [S2_tile, D]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="740" y="1180" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l0c_desc" value="Cube 引擎输出, 128 KB&lt;br&gt;L0C→UB 带宽: 256 bytes/cycle&lt;br&gt;INT8×INT8→INT32 累加" style="text;html=1;align=left;fontSize=10;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="40" y="1380" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="l0c_bmm1" value="&lt;b&gt;L0C: bmm1 结果&lt;/b&gt;&lt;br&gt;&lt;b&gt;INT32&lt;/b&gt; fractal [M0, N0]&lt;br&gt;= Q_BF16 (→INT8) × K^T_INT8&lt;br&gt;= [256, 128] 典型&lt;br&gt;INT32 累加, 后经 dequant scale 调整&lt;br&gt;→ 写回 UB (mm1ResUb)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="440" y="1380" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l0c_bmm2" value="&lt;b&gt;L0C: bmm2 结果&lt;/b&gt;&lt;br&gt;&lt;b&gt;INT32&lt;/b&gt; fractal [M0, N0]&lt;br&gt;= attn_INT8 × V_INT8&lt;br&gt;= [256, 128] 典型&lt;br&gt;INT32 累加, 后 dequant&lt;br&gt;→ 写回 UB (mm2ResUb)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="1040" y="1380" width="280" height="120" as="geometry" />
        </mxCell>
