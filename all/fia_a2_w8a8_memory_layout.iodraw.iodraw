        <mxCell id="legend0" value="关键要点" style="text;html=1;align=left;fontSize=14;fontStyle=5;" parent="1" vertex="1">
          <mxGeometry x="40" y="1540" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend1" value="1. &lt;b&gt;A2 W8A8 实际路径&lt;/b&gt;: Q 以 BF16 存储, 在 Cube 计算前转 INT8; KV cache 以 INT8 存储; Cube 执行 INT8×INT8→INT32" style="text;html=1;align=left;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="1570" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="2. &lt;b&gt;L1 完全打满&lt;/b&gt;: Q (192 KB) + V (128 KB) + KP (192 KB) = 512 KB, 刚好用满每核 L1 (fia_block_cube_nonquant_gqa.h:680-688)" style="text;html=1;align=left;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="1595" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend3" value="3. &lt;b&gt;多 buffer 流水线&lt;/b&gt;: Q/V 各 2 buffer, KP 3 buffer, 支持 MTE3 预取与 Cube 计算并行 (double/triple buffering)" style="text;html=1;align=left;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="1620" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend4" value="4. &lt;b&gt;Fractal 格式&lt;/b&gt;: L0A/L0B/L0C 都使用 Ascend 特有的 fractal NZ 格式 (M0=256, K0/N0=128, C0=16), 通过 IMG2COL/LOAD2D 转换" style="text;html=1;align=left;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="1645" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend5" value="5. &lt;b&gt;INT32 中间结果&lt;/b&gt;: bmm1/bmm2 在 L0C 累加为 INT32, 写回 UB 后经 dequant scale 调整 → FP32 → softmax → 再 INT8 量化回 L0A" style="text;html=1;align=left;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="1670" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend6" value="6. &lt;b&gt;GQA 特殊处理&lt;/b&gt;: Q 有 40 heads, KV 仅 8 heads, gSize=5. FiaBlockCubeNonQuantGqa 按 gSize 分组, 每 KV head 对应 5 个 Q head 复用同一 K/V" style="text;html=1;align=left;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="1695" width="1200" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
