        <mxCell id="gm_q" value="Q: [B, N1, 1, D]&lt;br&gt;&lt;b&gt;BF16&lt;/b&gt; row-major&lt;br&gt;[B, 40, 1, 128] = 10 KB/batch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
