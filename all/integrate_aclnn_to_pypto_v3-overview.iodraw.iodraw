        <mxCell id="5eRNpVH-V7YMr0wqcR8z-90" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;开发者基于DSL调用&lt;/b&gt;&lt;/span&gt;&lt;div&gt;&lt;div style=&quot;color: rgb(101, 123, 131); background-color: rgb(253, 246, 227); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #859900;&quot;&gt;import&lt;/span&gt; torch&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #859900;&quot;&gt;import&lt;/span&gt; pypto&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #268bd2;&quot;&gt;@pypto.frontend.jit&lt;/span&gt;(runtime_options&lt;span style=&quot;color: #859900;&quot;&gt;=&lt;/span&gt;{&lt;span style=&quot;color: #2aa198;&quot;&gt;&quot;run_mode&quot;&lt;/span&gt;: pypto.RunMode.&lt;span style=&quot;color: #cb4b16;&quot;&gt;NPU&lt;/span&gt;})&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #586e75;font-weight: bold;&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: #268bd2;&quot;&gt;moe_kernel&lt;/span&gt;(&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; permuted_tokens: pypto.Tensor([&lt;span style=&quot;color: #d33682;&quot;&gt;128&lt;/span&gt;, &lt;span style=&quot;color: #d33682;&quot;&gt;128&lt;/span&gt;], pypto.&lt;span style=&quot;color: #cb4b16;&quot;&gt;DT_FP16&lt;/span&gt;), &amp;nbsp; &amp;nbsp;&lt;span style=&quot;color: #93a1a1;font-style: italic;&quot;&gt;# 输入&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; sorted_indices: pypto.Tensor([&lt;span style=&quot;color: #d33682;&quot;&gt;128&lt;/span&gt;], pypto.&lt;span style=&quot;color: #cb4b16;&quot;&gt;DT_INT32&lt;/span&gt;), &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;span style=&quot;color: #93a1a1;font-style: italic;&quot;&gt;# 输入&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; unpermuted_tokens: pypto.Tensor([&lt;span style=&quot;color: #d33682;&quot;&gt;128&lt;/span&gt;, &lt;span style=&quot;color: #d33682;&quot;&gt;128&lt;/span&gt;], pypto.&lt;span style=&quot;color: #cb4b16;&quot;&gt;DT_FP16&lt;/span&gt;), &amp;nbsp; &lt;span style=&quot;color: #93a1a1;font-style: italic;&quot;&gt;# 输出（out 参数）&lt;/span&gt;&lt;/div&gt;&lt;div&gt;):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &lt;span style=&quot;color: #93a1a1;font-style: italic;&quot;&gt;# torch_npu 同款调用：位置传参，可选输入 probs 缺席&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; res &lt;span style=&quot;color: #859900;&quot;&gt;=&lt;/span&gt; pypto.npu_moe_token_unpermute(permuted_tokens, sorted_indices)&lt;/div&gt;&lt;div&gt;&amp;nbsp; unpermuted_tokens.move(res)&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #93a1a1;font-style: italic;&quot;&gt;# 边界：torch.Tensor 直进直出&lt;/span&gt;&lt;/div&gt;&lt;div&gt;pt &lt;span style=&quot;color: #859900;&quot;&gt;=&lt;/span&gt; torch.randn(&lt;span style=&quot;color: #d33682;&quot;&gt;128&lt;/span&gt;, &lt;span style=&quot;color: #d33682;&quot;&gt;128&lt;/span&gt;, dtype&lt;span style=&quot;color: #859900;&quot;&gt;=&lt;/span&gt;torch.float16, device&lt;span style=&quot;color: #859900;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #2aa198;&quot;&gt;&quot;npu&quot;&lt;/span&gt;)&lt;/div&gt;&lt;div&gt;si &lt;span style=&quot;color: #859900;&quot;&gt;=&lt;/span&gt; torch.randperm(&lt;span style=&quot;color: #d33682;&quot;&gt;128&lt;/span&gt;, device&lt;span style=&quot;color: #859900;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #2aa198;&quot;&gt;&quot;npu&quot;&lt;/span&gt;).to(torch.int32)&lt;/div&gt;&lt;div&gt;out &lt;span style=&quot;color: #859900;&quot;&gt;=&lt;/span&gt; torch.zeros(&lt;span style=&quot;color: #d33682;&quot;&gt;128&lt;/span&gt;, &lt;span style=&quot;color: #d33682;&quot;&gt;128&lt;/span&gt;, dtype&lt;span style=&quot;color: #859900;&quot;&gt;=&lt;/span&gt;torch.float16, device&lt;span style=&quot;color: #859900;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #2aa198;&quot;&gt;&quot;npu&quot;&lt;/span&gt;)&lt;/div&gt;&lt;div&gt;moe_kernel(pt, si, out) &amp;nbsp; &lt;span style=&quot;color: #93a1a1;font-style: italic;&quot;&gt;# 与 torch_npu.npu_moe_token_unpermute(pt, si) 逐位一致&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="1189" y="-450" width="650" height="390" as="geometry" />
        </mxCell>
