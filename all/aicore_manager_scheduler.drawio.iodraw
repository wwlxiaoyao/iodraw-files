        </mxCell>
        <mxCell id="pend-e22" value="CalcAdjAicoreEnd (devTask 切换)&#xa;pendReadyCnt_ = adjAicEnd_-aicStart_ (RESET)&#xa;lastPendReadyCoreIdx_ 保留不重置" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;fontColor=#3366CC;strokeColor=#3366CC;strokeWidth=2;dashed=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" parent="1" source="pend-s2" target="pend-s1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pend-note" value="lastPendReadyCoreIdx_ 游标语义:&#xa;  ├─ 指向环形扫描的起始位置，跨 BatchSendTask 调用保持 round-robin 公平性&#xa;  ├─ 每次 BatchSendTask 第二阶段成功派发后推进: (lastProcCore + 1) % coreNum&#xa;  ├─ CalcAdjAicoreEnd 不重置游标（跨 devTask 保留连续性）&#xa;  └─ 只有 UpdateAiCoreBlockIndexSection (Init) 才初始化为 aicStart_/aivStart_&#xa;&#xa;corePendReadyCnt_ 计数语义:&#xa;  ├─ 表示可派发核配额，同时覆盖快表 (runReadyCoreIdx_) 和环形扫描核&#xa;  ├─ 派发时递减 (BatchSendTask), 核完成时递增 (ReleaseCoreByRegVal pending FINISH)&#xa;  ├─ running FINISH 不递增 (核已在 pending FINISH 时归还配额)&#xa;  └─ devTask 切换时 RESET 为 adj 范围 (CalcAdjAicoreEnd)" style="text;html=1;strokeColor=#82b366;fillColor=#f0fff0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=8;fontSize=14;fontFamily=Courier New;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="720" y="2700" width="680" height="220" as="geometry" />
        </mxCell>
        <mxCell id="fast-s1" value="游离态&#xa;coreIdxPosition_ = INVALID (0xff)&#xa;不在快表中，只能环形扫描找到" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="-94" y="1901" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fast-s2" value="在表态&#xa;coreIdxPosition_ = [0..cnt-1]&#xa;在快表中，可 O(1) 派发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="-64" y="2221" width="450" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fast-e12-add" value="AddReadyCoreIdx&#xa;coreRunReadyCnt_++&#xa;coreIdxPosition_[i] = cnt" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;fontColor=#006600;strokeColor=#006600;strokeWidth=2;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.189;entryY=-0.033;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="286" y="3291" as="sourcePoint" />
            <mxPoint x="281.0500000000002" y="3537.040000000001" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fast-e21-rm" value="RemoveRunReadyCoreIdx (mid)&#xa;tail-swap: 尾元素移到删除位&#xa;coreRunReadyCnt_--&#xa;coreIdxPosition_[i] = INVALID" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;fontColor=#CC0000;strokeColor=#CC0000;strokeWidth=2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="66" y="3601" />
              <mxPoint x="66" y="3256" />
            </Array>
            <mxPoint x="196" y="3601" as="sourcePoint" />
            <mxPoint x="166" y="3256" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fast-e21-tail" value="RemoveReadyCoreIdxTail (tail)&#xa;从快表尾部弹出 (LIFO)&#xa;coreRunReadyCnt_--&#xa;coreIdxPosition_[i] = INVALID" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;fontColor=#CC6600;strokeColor=#CC6600;strokeWidth=2;exitX=0.847;exitY=-0.008;exitDx=0;exitDy=0;entryX=0.844;entryY=0.986;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="fast-s2" target="fast-s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fast-e22-swap" value="RemoveRunReadyCoreIdx (间接)&#xa;其他核被 mid-remove 时&#xa;tail-swap 改变本核位置" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;fontColor=#999999;strokeColor=#999999;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fast-s2" target="fast-s2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="476" y="2281" />
              <mxPoint x="476" y="2411" />
              <mxPoint x="161" y="2411" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fast-note" value="快表操作接口:&#xa;  AddReadyCoreIdx:        游离→在表, cnt++, 追加到尾部&#xa;  RemoveRunReadyCoreIdx:   在表→游离, cnt--, 尾交换保持数组紧凑&#xa;  RemoveReadyCoreIdxTail:  在表→游离, cnt--, 仅尾部弹出&#xa;&#xa;调用者:&#xa;  AddReadyCoreIdx 入口:&#xa;    HandShake (握手成功)&#xa;    ReleaseCoreByRegVal (pending FINISH 双完成)&#xa;    ReleaseCoreByRegVal (running FINISH, pending=INIT)&#xa;    CheckStopTaskCanBeSent (尾批停止)&#xa;    UpdateRunReadyCoreNum (adj 范围扩大, 增量)&#xa;    DynamicAdjustCorePartition (DAV_2002 分区翻转)&#xa;    UpdateAiCoreBlockIndexSection (DEV_IF_NONDEVICE 初始化)&#xa;&#xa;  RemoveRunReadyCoreIdx 入口:&#xa;    UpdateRunReadyCoreNum (adj 范围缩小)&#xa;    DynamicAdjustCorePartition (DAV_2002 分区翻转)&#xa;&#xa;  RemoveReadyCoreIdxTail 入口:&#xa;    BatchSendTask 第一阶段 (快表派发 LIFO)&#xa;&#xa;关键约束:&#xa;  coreRunReadyCnt_[type] ≤ coreNum (BatchSendTask 检查)&#xa;  coreIdxPosition_ 默认值 0 ≠ INVALID 0xff (潜在 bug)&#xa;  --coreRunReadyCnt_ 若为 0 则 uint8_t 下溢到 255" style="text;html=1;strokeColor=#82b366;fillColor=#f0fff0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=8;fontSize=14;fontFamily=Courier New;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="720" y="1870" width="510" height="480" as="geometry" />
        </mxCell>
        <mxCell id="5aYVAsXicacRLBcelbmh-2" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#FF00FF;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="-372" y="2231" as="sourcePoint" />
            <mxPoint x="-212" y="2871" as="targetPoint" />
            <Array as="points">
              <mxPoint x="-372" y="2221" />
              <mxPoint x="-372" y="2871" />
            </Array>
